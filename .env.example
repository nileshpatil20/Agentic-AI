# Copy this file to .env and fill in the values.
# Never commit your real .env file.

# Notion internal integration token
NOTION_API_KEY=

# Optional alias (final.py also checks this name)
NOTION_API_TOKEN=

# Required if you run final.py with ngrok
NGROK_AUTH_TOKEN=

# Used by OpenAIChatCompletionClient
OPENAI_API_KEY=
